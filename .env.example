POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pos_db

# Dentro de Docker se usa host postgres.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pos_db

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
BACKUP_DIR=/app/backend/backups
POSTGRES_CONTAINER=pos_postgres

# Gmail / Nodemailer
# Usa una App Password de Google, no la contraseña normal de la cuenta.
MAIL_USER=tu-correo@gmail.com
MAIL_APP_PASSWORD=tu-app-password
MAIL_TO=destino@correo.com
