NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Docker:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pos_db
# Local sin Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
BACKUP_DIR=./backups
POSTGRES_CONTAINER=pos_postgres

# Gmail / Nodemailer
# Usa una App Password de Google, no la contraseña normal de la cuenta.
MAIL_USER=tu-correo@gmail.com
MAIL_APP_PASSWORD=tu-app-password
MAIL_TO=destino@correo.com
